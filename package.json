{
  "name": "@afterswf/embed",
  "version": "0.1.5",
  "description": "AfterSWF: plays Flash content in the browser as a drop-in replacement for SWFObject, based on AwayFL",
  "main": "dist/embed.js",
  "module": "dist/embed.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/embed.mjs",
      "default": "./dist/embed.js"
    },
    "./version": {
      "types": "./types/version.d.ts",
      "default": "./dist/version.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "clean": "rimraf --glob ./dist/*",
    "static": "copyfiles -u 1 './static/**/*' ./dist/assets/",
    "prebuild": "npm run clean && npm run static",
    "build": "rollup -c --bundleConfigAsCjs --forceExit",
    "version": "npm run build && git add -A dist HISTORY.txt",
    "prepublishOnly": "node bumpIfPublished.mjs"
  },
  "keywords": [
    "Flash",
    "SWF",
    "SWFObject",
    "AwayFL",
    "AfterSWF"
  ],
  "author": "eXponenta",
  "license": "MIT",
  "homepage": "https://github.com/afterswf/embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afterswf/embed.git"
  },
  "bugs": {
    "url": "https://github.com/afterswf/embed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@awayfl/avm1": "file:../avm1",
    "@awayfl/avm2": "file:../avm2",
    "@awayfl/awayfl-player": "^0.2.40",
    "@awayfl/playerglobal": "file:../playerglobal",
    "@awayfl/swf-loader": "^0.4.121",
    "@awayjs/core": "^0.9.44",
    "@awayjs/graphics": "file:../graphics",
    "@awayjs/materials": "^0.6.16",
    "@awayjs/renderer": "file:../renderer",
    "@awayjs/scene": "file:../scene",
    "@awayjs/stage": "^0.11.138",
    "@awayjs/view": "^0.6.61",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "copyfiles": "^2.4.1",
    "random-seed": "^0.3.0",
    "rimraf": "^5.0.5",
    "rollup": "4.6.1",
    "rollup-plugin-string": "^3.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "tslib": "^2.6.2",
    "typescript": "5.3.3"
  },
  "lastUsedTags": {
    "@awayfl/avm1": "v0.2.182",
    "@awayfl/avm2": "v0.2.241",
    "@awayfl/awayfl-player": "v0.1.4",
    "@awayfl/playerglobal": "v0.2.461",
    "@awayfl/swf-loader": "v0.1.4",
    "@awayjs/core": "v0.1.4",
    "@awayjs/graphics": "v0.5.101",
    "@awayjs/materials": "v0.1.4",
    "@awayjs/renderer": "v0.11.99",
    "@awayjs/scene": "v0.13.326",
    "@awayjs/stage": "v0.1.4",
    "@awayjs/view": "v0.1.4"
  }
}