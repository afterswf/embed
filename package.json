{
  "name": "@afterswf/embed",
  "version": "0.1.4",
  "description": "Embedded AwayFL Player for static publishing",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf --glob ./dist/*",
    "static": "copyfiles -u 1 './static/**/*' ./dist/assets/",
    "prebuild": "npm run clean && npm run static",
    "build": "rollup -c --bundleConfigAsCjs",
    "version": " npm run build"
  },
  "keywords": [
    "Flash",
    "AwayFL",
    "SWF"
  ],
  "author": "eXponenta",
  "license": "MIT",
  "repository": "https://github.com/awayfl/awayfl-embed",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "dependencies": {
    "@awayfl/avm1": "file:../avm1",
    "@awayfl/avm2": "file:../avm2",
    "@awayfl/awayfl-player": "^0.2.40",
    "@awayfl/playerglobal": "file:../playerglobal",
    "@awayfl/swf-loader": "^0.4.121",
    "@awayjs/core": "^0.9.44",
    "@awayjs/graphics": "file:../graphics",
    "@awayjs/materials": "^0.6.16",
    "@awayjs/renderer": "^0.11.63",
    "@awayjs/scene": "^0.13.264",
    "@awayjs/stage": "^0.11.138",
    "@awayjs/view": "^0.6.61",
    "random-seed": "^0.3.0",
    "rollup-plugin-string": "^3.0.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "copyfiles": "^2.4.1",
    "rimraf": "^5.0.5",
    "rollup": "4.6.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "5.3.3"
  },
  "lastUsedTags": {
    "@awayfl/avm1": "v0.2.181",
    "@awayfl/avm2": "v0.2.241",
    "@awayfl/awayfl-player": "v0.1.4",
    "@awayfl/playerglobal": "v0.2.460",
    "@awayfl/swf-loader": "v0.1.4",
    "@awayjs/core": "v0.1.4",
    "@awayjs/graphics": "v0.5.101",
    "@awayjs/materials": "v0.1.4",
    "@awayjs/renderer": "v0.1.4",
    "@awayjs/scene": "v0.1.4",
    "@awayjs/stage": "v0.1.4",
    "@awayjs/view": "v0.1.4"
  }
}